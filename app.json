{
  "expo": {
    "name": "my-expo-app",
    "slug": "my-expo-app",
    "scheme": "go2s",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "places shows your location on the map and nearby places."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "places shows your location on the map and nearby places.",
          "locationAlwaysAndWhenInUsePermission": "places shows your location on the map and nearby places.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-router"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.go2s.app",
      "appleTeamId": "V4X9FL23DT",
      "deploymentTarget": "18.0",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "places shows your location on the map and nearby places.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.go2s.app"
    }
  }
}
